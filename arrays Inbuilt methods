//splice : delete elements..........................................
function mysplice(arr,startindex,deletecount)
{
    for(let i=startindex;i<arr.length-deletecount;i++)
    {
        arr[i]=arr[deletecount+i];
    }
    arr.length=arr.length-deletecount;
}
let arr=[1,2,3,4,5,6];
mysplice(arr, 1, 2);
